# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 매직링크 로그인을 허용할 단 하나의 관리자 이메일 (docs/access-control.md 참고)
ALLOWED_ADMIN_EMAIL=

# 매직링크 리다이렉트용. 로컬은 http://localhost:3000,
# 배포 후에는 실제 도메인으로. Supabase Redirect URLs에도 <이 값>/auth/confirm을 등록해야 함
NEXT_PUBLIC_SITE_URL=http://localhost:3000
